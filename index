<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Normal Distribution</title>
    <style>
        /* Base styles and CSS variables for theming and a11y */
        :root {
            --primary-color: #0056b3;
            --primary-hover: #004494;
            --focus-ring: #ffbf47;
            --bg-color: #f8f9fa;
            --surface-color: #ffffff;
            --text-color: #212529;
            --border-color: #ced4da;
            --error-color: #dc3545;
            --graph-fill: rgba(0, 86, 179, 0.25);
            --graph-stroke: #0056b3;
            --axis-color: #495057;
            --font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 1rem;
        }

        /* Skip link for keyboard users */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--primary-color);
            color: white;
            padding: 8px;
            z-index: 100;
            transition: top 0.2s;
            text-decoration: none;
        }

        .skip-link:focus {
            top: 0;
            outline: 3px solid var(--focus-ring);
        }

        header {
            max-width: 1000px;
            margin: 0 auto 1.5rem auto;
            text-align: center;
        }

        h1 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
            color: var(--primary-color);
        }

        main {
            max-width: 1000px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
            background: var(--surface-color);
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        @media (min-width: 768px) {
            main {
                grid-template-columns: 350px 1fr;
            }
        }

        /* Form Controls */
        .controls-section {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        fieldset {
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 1rem;
            background: var(--bg-color);
        }

        legend {
            font-weight: 600;
            padding: 0 0.5rem;
            background: var(--bg-color);
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .form-group:last-child {
            margin-bottom: 0;
        }

        label {
            font-weight: 600;
            font-size: 0.95rem;
        }

        input[type="number"], select {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-size: 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input:focus, select:focus, button:focus {
            outline: 3px solid var(--focus-ring);
            outline-offset: 2px;
            border-color: var(--primary-color);
        }

        .error-message {
            color: var(--error-color);
            font-size: 0.875rem;
            font-weight: 600;
            display: none; /* Hidden by default */
            margin-top: 0.25rem;
        }

        /* Visualization Area */
        .visualization-section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .canvas-container {
            width: 100%;
            position: relative;
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
            aspect-ratio: 16 / 9;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        .result-panel {
            background: var(--bg-color);
            padding: 1rem;
            border-left: 4px solid var(--primary-color);
            border-radius: 0 4px 4px 0;
            font-size: 1.1rem;
            font-weight: 600;
        }

        /* Utility */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header>
        <h1>Normal Distribution Explorer</h1>
        <p>Interactive tool to visualize probabilities and areas under the bell curve.</p>
    </header>

    <main id="main-content">
        <!-- Controls -->
        <section class="controls-section" aria-labelledby="controls-heading">
            <h2 id="controls-heading" class="sr-only">Distribution Parameters</h2>
            
            <form id="calc-form" novalidate>
                <fieldset>
                    <legend>Population Parameters</legend>
                    
                    <div class="form-group">
                        <label for="mu">Population Mean (&mu;)</label>
                        <input type="number" id="mu" name="mu" value="0" step="any" required aria-describedby="mu-desc">
                        <span id="mu-desc" class="sr-only">Enter the center value of the distribution</span>
                    </div>

                    <div class="form-group">
                        <label for="sigma">Population Standard Deviation (&sigma;)</label>
                        <input type="number" id="sigma" name="sigma" value="1" step="any" min="0.0001" required aria-describedby="sigma-error">
                        <div id="sigma-error" class="error-message" aria-live="polite">Standard Deviation must be greater than zero.</div>
                    </div>
                </fieldset>

                <fieldset style="margin-top: 1.5rem;">
                    <legend>Area Calculation</legend>
                    
                    <div class="form-group">
                        <label for="calc-type">Find area:</label>
                        <select id="calc-type" name="calc-type">
                            <option value="left">To the left of a value</option>
                            <option value="right">To the right of a value</option>
                            <option value="between">Between two values</option>
                        </select>
                    </div>

                    <div class="form-group" id="x1-group">
                        <label for="x1" id="x1-label">Value (x)</label>
                        <input type="number" id="x1" name="x1" value="-1" step="any" required>
                    </div>

                    <div class="form-group hidden" id="x2-group">
                        <label for="x2">Second Value (x&#8322;)</label>
                        <input type="number" id="x2" name="x2" value="1" step="any">
                        <div id="range-error" class="error-message" aria-live="polite">Second value must be greater than the first value.</div>
                    </div>
                </fieldset>
            </form>
        </section>

        <!-- Visualization and Results -->
        <section class="visualization-section" aria-labelledby="vis-heading">
            <h2 id="vis-heading" class="sr-only">Graph and Results</h2>
            
            <div class="result-panel" aria-live="polite" aria-atomic="true">
                <span id="result-text">Calculating...</span>
            </div>

            <div class="canvas-container">
                <canvas id="bell-curve" role="img" aria-label="Interactive graph of the normal distribution."></canvas>
            </div>
            
            <!-- Accessible description of the visual graph -->
            <div id="graph-description" class="sr-only" aria-live="polite">
                Graph showing a normal distribution curve. 
            </div>
        </section>
    </main>

    <script>
        /**
         * Math and Statistics Functions
         */
        
        // Probability Density Function (PDF) for Normal Distribution
        function normalPDF(x, mu, sigma) {
            const variance = sigma * sigma;
            const exponent = -Math.pow(x - mu, 2) / (2 * variance);
            return (1 / (sigma * Math.sqrt(2 * Math.PI))) * Math.exp(exponent);
        }

        // Cumulative Distribution Function (CDF) Approximation
        // Abramowitz and Stegun 7.1.26 approximation, max error 1.5e-7
        function normalCDF(x, mu, sigma) {
            const z = (x - mu) / sigma;
            const p = 0.2316419;
            const b1 = 0.319381530;
            const b2 = -0.356563782;
            const b3 = 1.781477937;
            const b4 = -1.821255978;
            const b5 = 1.330274429;

            const t = 1 / (1 + p * Math.abs(z));
            const Z = (1 / Math.sqrt(2 * Math.PI)) * Math.exp(-0.5 * z * z);
            const prob = 1 - Z * (b1 * t + b2 * Math.pow(t, 2) + b3 * Math.pow(t, 3) + b4 * Math.pow(t, 4) + b5 * Math.pow(t, 5));

            if (z < 0) return 1 - prob;
            return prob;
        }

        /**
         * Application State and UI Logic
         */
        
        const ui = {
            mu: document.getElementById('mu'),
            sigma: document.getElementById('sigma'),
            calcType: document.getElementById('calc-type'),
            x1: document.getElementById('x1'),
            x2: document.getElementById('x2'),
            x1Group: document.getElementById('x1-group'),
            x2Group: document.getElementById('x2-group'),
            x1Label: document.getElementById('x1-label'),
            sigmaError: document.getElementById('sigma-error'),
            rangeError: document.getElementById('range-error'),
            resultText: document.getElementById('result-text'),
            canvas: document.getElementById('bell-curve'),
            graphDesc: document.getElementById('graph-description'),
            form: document.getElementById('calc-form')
        };

        const ctx = ui.canvas.getContext('2d');

        // Setup resize observer for responsive canvas
        const resizeObserver = new ResizeObserver(() => {
            updateVisualization();
        });
        resizeObserver.observe(ui.canvas.parentElement);

        // Bind events
        ui.form.addEventListener('input', updateVisualization);
        ui.calcType.addEventListener('change', handleTypeChange);
        
        function handleTypeChange() {
            const type = ui.calcType.value;
            if (type === 'between') {
                ui.x2Group.classList.remove('hidden');
                ui.x2.setAttribute('required', 'true');
                ui.x1Label.textContent = 'First Value (x\u2081)';
            } else {
                ui.x2Group.classList.add('hidden');
                ui.x2.removeAttribute('required');
                ui.x1Label.textContent = 'Value (x)';
            }
            updateVisualization();
        }

        function updateVisualization() {
            // 1. Parse and Validate Inputs
            const mu = parseFloat(ui.mu.value);
            const sigma = parseFloat(ui.sigma.value);
            const type = ui.calcType.value;
            const x1 = parseFloat(ui.x1.value);
            const x2 = parseFloat(ui.x2.value);

            let hasError = false;

            // Validate Sigma
            if (isNaN(sigma) || sigma <= 0) {
                ui.sigma.setAttribute('aria-invalid', 'true');
                ui.sigmaError.style.display = 'block';
                hasError = true;
            } else {
                ui.sigma.removeAttribute('aria-invalid');
                ui.sigmaError.style.display = 'none';
            }

            // Validate Between Range
            if (type === 'between' && !isNaN(x1) && !isNaN(x2) && x1 >= x2) {
                ui.x2.setAttribute('aria-invalid', 'true');
                ui.rangeError.style.display = 'block';
                hasError = true;
            } else {
                ui.x2.removeAttribute('aria-invalid');
                ui.rangeError.style.display = 'none';
            }

            // If required fields are missing or invalid, do not proceed with drawing
            if (hasError || isNaN(mu) || isNaN(x1) || (type === 'between' && isNaN(x2))) {
                ui.resultText.textContent = "Please enter valid numbers to calculate area.";
                clearCanvas();
                return;
            }

            // 2. Calculate Math
            let area = 0;
            let resultString = "";
            let screenReaderDesc = "";

            if (type === 'left') {
                area = normalCDF(x1, mu, sigma);
                resultString = `Area to the left of ${x1}: ${(area * 100).toFixed(2)}% (Prob = ${area.toFixed(4)})`;
                screenReaderDesc = `The graph shows a normal distribution with mean ${mu} and standard deviation ${sigma}. The area to the left of ${x1} is shaded, representing a probability of ${area.toFixed(4)}.`;
            } else if (type === 'right') {
                area = 1 - normalCDF(x1, mu, sigma);
                resultString = `Area to the right of ${x1}: ${(area * 100).toFixed(2)}% (Prob = ${area.toFixed(4)})`;
                screenReaderDesc = `The graph shows a normal distribution with mean ${mu} and standard deviation ${sigma}. The area to the right of ${x1} is shaded, representing a probability of ${area.toFixed(4)}.`;
            } else if (type === 'between') {
                area = normalCDF(x2, mu, sigma) - normalCDF(x1, mu, sigma);
                resultString = `Area between ${x1} and ${x2}: ${(area * 100).toFixed(2)}% (Prob = ${area.toFixed(4)})`;
                screenReaderDesc = `The graph shows a normal distribution with mean ${mu} and standard deviation ${sigma}. The area between ${x1} and ${x2} is shaded, representing a probability of ${area.toFixed(4)}.`;
            }

            ui.resultText.textContent = resultString;
            ui.graphDesc.textContent = screenReaderDesc;
            ui.canvas.setAttribute('aria-label', screenReaderDesc); // Backup for visual element

            // 3. Draw Graph
            drawCurve(mu, sigma, type, x1, x2);
        }

        function clearCanvas() {
            ctx.clearRect(0, 0, ui.canvas.width, ui.canvas.height);
        }

        function drawCurve(mu, sigma, type, x1, x2) {
            // Handle high DPI displays for crisp rendering
            const rect = ui.canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            ui.canvas.width = rect.width * dpr;
            ui.canvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);

            const width = rect.width;
            const height = rect.height;
            const margin = { top: 20, right: 30, bottom: 40, left: 30 };
            
            const graphWidth = width - margin.left - margin.right;
            const graphHeight = height - margin.top - margin.bottom;

            // Determine visible X range (usually mean ± 4 standard deviations)
            const minX = mu - 4 * sigma;
            const maxX = mu + 4 * sigma;
            
            // Determine maximum Y value (at the mean) for scaling, add 10% padding
            const maxY = normalPDF(mu, mu, sigma) * 1.1;

            // Helper mapping functions
            const mapX = (xVal) => margin.left + ((xVal - minX) / (maxX - minX)) * graphWidth;
            const mapY = (yVal) => margin.top + graphHeight - (yVal / maxY) * graphHeight;

            clearCanvas();

            // Setup styles
            ctx.lineWidth = 2;
            const colorStroke = getComputedStyle(document.documentElement).getPropertyValue('--graph-stroke').trim();
            const colorFill = getComputedStyle(document.documentElement).getPropertyValue('--graph-fill').trim();
            const colorAxis = getComputedStyle(document.documentElement).getPropertyValue('--axis-color').trim();
            const colorText = getComputedStyle(document.documentElement).getPropertyValue('--text-color').trim();

            // Draw Axis
            ctx.beginPath();
            ctx.moveTo(margin.left, mapY(0));
            ctx.lineTo(margin.left + graphWidth, mapY(0));
            ctx.strokeStyle = colorAxis;
            ctx.stroke();

            // Generate points for the curve
            const numPoints = 200;
            const points = [];
            for (let i = 0; i <= numPoints; i++) {
                const x = minX + (i / numPoints) * (maxX - minX);
                const y = normalPDF(x, mu, sigma);
                points.push({ x, y, cx: mapX(x), cy: mapY(y) });
            }

            // Draw Shaded Region
            ctx.beginPath();
            let startedFill = false;
            
            // Initial point to drop down to axis
            ctx.moveTo(points[0].cx, mapY(0));

            for (const pt of points) {
                let isShaded = false;
                if (type === 'left' && pt.x <= x1) isShaded = true;
                if (type === 'right' && pt.x >= x1) isShaded = true;
                if (type === 'between' && pt.x >= x1 && pt.x <= x2) isShaded = true;

                if (isShaded) {
                    if (!startedFill) {
                        ctx.lineTo(pt.cx, mapY(0)); // Drop to baseline before starting shade
                        startedFill = true;
                    }
                    ctx.lineTo(pt.cx, pt.cy);
                } else if (startedFill) {
                    ctx.lineTo(pt.cx, mapY(0)); // Drop to baseline ending shade
                    startedFill = false;
                }
            }
            
            // Finish fill path
            if (startedFill) {
                const lastPt = points[points.length - 1];
                ctx.lineTo(lastPt.cx, mapY(0));
            }
            
            ctx.fillStyle = colorFill;
            ctx.fill();

            // Draw Bell Curve Line
            ctx.beginPath();
            ctx.moveTo(points[0].cx, points[0].cy);
            for (const pt of points) {
                ctx.lineTo(pt.cx, pt.cy);
            }
            ctx.strokeStyle = colorStroke;
            ctx.lineWidth = 3;
            ctx.stroke();

            // Draw Ticks and Labels
            ctx.fillStyle = colorText;
            ctx.font = "14px system-ui, sans-serif";
            ctx.textAlign = "center";
            ctx.textBaseline = "top";

            // Shaded boundary ticks
            const drawTick = (val, label) => {
                if (val < minX || val > maxX) return; // don't draw if out of bounds
                ctx.beginPath();
                ctx.moveTo(mapX(val), mapY(0));
                ctx.lineTo(mapX(val), mapY(normalPDF(val, mu, sigma)));
                ctx.setLineDash([5, 5]);
                ctx.stroke();
                ctx.setLineDash([]);
                ctx.fillText(label, mapX(val), mapY(0) + 10);
            };

            if (type === 'left' || type === 'right') {
                if (Math.abs(x1 - mu) > 0.1) { // prevent overlapping text with mean
                     drawTick(x1, x1.toString());
                }
            } else if (type === 'between') {
                if (Math.abs(x1 - mu) > 0.1) drawTick(x1, x1.toString());
                if (Math.abs(x2 - mu) > 0.1) drawTick(x2, x2.toString());
            }
        }

        // Initialize application on load
        window.addEventListener('DOMContentLoaded', () => {
            handleTypeChange(); // Sets up initial view state
            updateVisualization(); // Draws the initial graph
        });
    </script>
</body>
</html>
